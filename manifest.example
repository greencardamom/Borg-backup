# borg-backup manifest - LOCAL FILE, deliberately NOT in this repo.
# It names every host, source path and destination in the fleet: a topology map.
# Authored on the hub, distributed by push-manifest.sh, age-backed-up via collect-secrets.
#
# ---- globals ----
set passphrase-file /home/greenc/scripts/secrets/borg.passphrase
set key-export-dir   /home/greenc/scripts/secrets/borg-keys
set retention       keep-daily=3,keep-weekly=6,keep-monthly=24
set compression     zstd

# ---- destinations:  dest <name> <host>:<base-path> [retention-override] ----
dest rabbit  rabbit:/home/greenc/Backup
# dest sheep sheep:/mnt/big/Backup  keep-daily=7,keep-weekly=12,keep-monthly=36

# ---- backups:  <host> <label> <dests> <source> [exclude,exclude,...] ----
# Repo path is derived: <dest base>/<host>-<label>, so acre+toolforge -> rabbit:~/Backup/acre-toolforge
# <dests> is comma-separated: list two destinations for data you want on two machines.
# Excludes are for CHURN AND BULK ONLY - the repo is encrypted, so nothing needs excluding
# for secrecy. Excluding by "might be secret" is guesswork that fails silently.
acre  toolforge  rabbit  /home/greenc/toolforge
acre  projects   rabbit  /home/greenc/projects   node_modules,__pycache__,venv,.venv
